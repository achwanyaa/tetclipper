{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w editor",
  "outputDirectory": "editor/dist",
  "redirects": [{ "source": "/", "destination": "/studio/", "permanent": false }],
  "rewrites": [
    { "source": "/studio/", "destination": "/index.html" },
    { "source": "/studio/:path*", "destination": "/:path*" }
  ]
}
