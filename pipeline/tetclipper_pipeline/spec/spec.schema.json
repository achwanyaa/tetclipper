{
  "$ref": "#/definitions/ClipSpec",
  "definitions": {
    "ClipSpec": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1,
          "default": 1
        },
        "title": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "start": {
              "type": "number",
              "minimum": 0
            },
            "end": {
              "type": "number",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 1920
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 1080
            }
          },
          "required": [
            "src",
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        "intro": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "src": {
                  "type": "string"
                },
                "duration": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 5,
                  "default": 2
                },
                "fit": {
                  "type": "string",
                  "enum": [
                    "cover",
                    "contain"
                  ],
                  "default": "cover"
                }
              },
              "required": [
                "src"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cuts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "music": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "src": {
                  "type": "string"
                },
                "volume": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.25
                },
                "duck": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.35
                },
                "offset": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0
                },
                "fadeIn": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10,
                  "default": 1
                },
                "fadeOut": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10,
                  "default": 1.5
                },
                "loop": {
                  "type": "boolean",
                  "default": true
                }
              },
              "required": [
                "src"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "emphasis": {
                "type": "boolean"
              },
              "hidden": {
                "type": "boolean"
              },
              "speaker": {
                "type": "string"
              }
            },
            "required": [
              "text",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "doubts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "to": {
                "type": "integer",
                "minimum": 0
              },
              "reason": {
                "type": "string"
              },
              "alt": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to",
              "reason"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "captions": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "style": {
              "type": "string",
              "enum": [
                "classic",
                "beast",
                "hormozi",
                "minimal",
                "karaoke-pop",
                "sermon",
                "one-word",
                "boxed",
                "neon"
              ],
              "default": "hormozi"
            },
            "position": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maxWords": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "color": {
              "type": "string"
            },
            "activeColor": {
              "type": "string"
            },
            "emphasisColor": {
              "type": "string"
            },
            "uppercase": {
              "type": "boolean"
            },
            "emoji": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "crop": {
          "type": "object",
          "properties": {
            "keyframes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "t": {
                    "type": "number",
                    "minimum": 0
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.5
                  },
                  "zoom": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 4,
                    "default": 1
                  },
                  "cut": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "t",
                  "x"
                ],
                "additionalProperties": false
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "effects": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "punch-in"
                  },
                  "at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "duration": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 2,
                    "default": 1.12
                  }
                },
                "required": [
                  "type",
                  "at",
                  "duration"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "shake"
                  },
                  "at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "duration": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "intensity": {
                    "type": "number",
                    "default": 12
                  }
                },
                "required": [
                  "type",
                  "at",
                  "duration"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "flash"
                  },
                  "at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "duration": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "type",
                  "at",
                  "duration"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "emoji"
                  },
                  "at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "duration": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "emoji": {
                    "type": "string"
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.5
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.3
                  },
                  "size": {
                    "type": "number",
                    "default": 180
                  }
                },
                "required": [
                  "type",
                  "at",
                  "duration",
                  "emoji"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "hook"
                  },
                  "at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "duration": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "text": {
                    "type": "string"
                  },
                  "background": {
                    "type": "string",
                    "default": "#FFD700"
                  },
                  "color": {
                    "type": "string",
                    "default": "#000000"
                  }
                },
                "required": [
                  "type",
                  "at",
                  "duration",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "image"
                  },
                  "at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "duration": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "src": {
                    "type": "string"
                  },
                  "layout": {
                    "type": "string",
                    "enum": [
                      "full",
                      "top"
                    ],
                    "default": "top"
                  }
                },
                "required": [
                  "type",
                  "at",
                  "duration",
                  "src"
                ],
                "additionalProperties": false
              }
            ]
          },
          "default": []
        },
        "progressBar": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "color": {
              "type": "string",
              "default": "#FFD700"
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
